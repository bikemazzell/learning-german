            { "id": "q1", "prompt": "Wann ist der Termin?", "options": ["am Montag", "am Dienstag", "am Donnerstag"], "answer": "am Dienstag", "explanation": "Im Text steht: am Dienstag um 9.30 Uhr." },
            { "id": "q2", "prompt": "Was soll Frau Weber mitbringen?", "options": ["einen Pass", "eine Versicherungskarte", "ein Foto"], "answer": "eine Versicherungskarte", "explanation": "Sie soll ihre Versicherungskarte mitbringen." },
            { "id": "q3", "prompt": "Wo ist der Termin?", "options": ["in einer Praxis", "im Supermarkt", "im Kino"], "answer": "in einer Praxis", "explanation": "Der Text kommt von Praxis Dr. Klein." }
          ]
        },
        {
